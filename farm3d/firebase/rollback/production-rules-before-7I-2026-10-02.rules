rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {
function isOwner() {
return request.auth != null && request.auth.token.email == "pederaus9@gmail.com";
}
match /farms/{uid} {
allow read, write: if request.auth != null && request.auth.uid == uid;
allow read: if isOwner();
}
match /presence/{uid} {
allow write: if request.auth != null && request.auth.uid == uid;
allow read: if isOwner();
}
match /players/{uid} {
allow read: if request.auth != null;
allow write: if request.auth != null && request.auth.uid == uid;
match /friends/{fid} {
allow read, write: if request.auth != null && request.auth.uid == uid;
}
}
match /usernames/{name} {
allow read: if request.auth != null;
allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
}
match /showcase/{uid} {
allow read: if request.auth != null;
allow write: if request.auth != null && request.auth.uid == uid;
}
match /help/{owner}/items/{id} {
allow create: if request.auth != null && request.resource.data.from == request.auth.uid && owner != request.auth.uid;
allow read, delete: if request.auth != null && request.auth.uid == owner;
}
match /market/{id} {
allow read: if request.auth != null;
allow create: if request.auth != null && request.resource.data.seller == request.auth.uid && request.resource.data.buyer == null;
allow delete: if request.auth != null && resource.data.seller == request.auth.uid;
allow update: if request.auth != null && resource.data.buyer == null && request.resource.data.buyer == request.auth.uid
&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buyer', 'buyerName', 'soldAt']);
}
match /events/{id} {
allow create: if request.resource.data.keys().hasOnly(['e', 'd'])
&& request.resource.data.e is string && request.resource.data.e.size() <= 24
&& request.resource.data.d is string && request.resource.data.d.size() == 10;
allow read: if isOwner();
}
}
}
