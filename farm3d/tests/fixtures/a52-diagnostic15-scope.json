    "farm3d/tests/helpers/a52-walk-phase.cjs": {
      "beforeSha256": "76206d7ea4b47a689e961eb298a9d9494b9d066a04e20557d439bc4b43d45f12",
      "afterSha256": "df16b5f5035e70d4f8923526a5f0175348dd1967024ed7790ff8f7e975799f97",
      "edits": [
        {
          "old": "function validProjection(v)",
          "new": "const STRIDE_KEYS=Object.freeze(['samples','mismatches','lowSpeed','moving','unknown']);\nfunction validStride(v){return !!v&&Object.keys(v).sort().join('|')==='lowSpeed|mismatches|moving|samples|unknown'&&STRIDE_KEYS.every(k=>Number.isInteger(v[k])&&v[k]>=0&&v[k]<=255)&&v.mismatches<=v.samples&&Math.min(255,v.lowSpeed+v.moving+v.unknown)===v.mismatches;}\nfunction summarizeStride(rows){if(!Array.isArray(rows))return null;const v={samples:Math.min(255,rows.length),mismatches:0,lowSpeed:0,moving:0,unknown:0};for(const s of rows){if(!(Math.abs(s?.phase-s?.walkPhase)<1e-9)){const k=s?.speedClass==='low'?'lowSpeed':s?.speedClass==='moving'?'moving':'unknown';v[k]=Math.min(255,v[k]+1);v.mismatches=Math.min(255,v.mismatches+1);}}return v;}\nfunction validProjection(v)"
        },
        {
          "old": "Object.keys(v).sort().join('|')==='checkpoint|cleanup|cleanupError|error|schema|state'",
          "new": "Object.keys(v).filter(k=>k!=='stride').sort().join('|')==='checkpoint|cleanup|cleanupError|error|schema|state'&&(!('stride'in v)||(v.checkpoint>=17&&validStride(v.stride)))"
        },
        {
          "old": "return {mark(n)",
          "new": "return {stride(rows){const summary=summarizeStride(rows);return value?.checkpoint===17&&value.state==='entered'&&value.cleanup==='not_observed'&&summary?write({...value,stride:summary}):false;},mark(n)"
        },
        {
          "old": "module.exports={PHASES,ERRORS,category,validProjection,create};",
          "new": "module.exports={PHASES,ERRORS,STRIDE_KEYS,validStride,summarizeStride,category,validProjection,create};"
        }
      ]
    },
